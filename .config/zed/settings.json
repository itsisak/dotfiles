{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "icon_theme": "Catppuccin Macchiato",
  "agent": {
    "dock": "right",
    "model_parameters": [],
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o",
    },
  },
  "auto_install_extensions": {
    "catppuccin": true,
    "git-firefly": true,
    "dockerfile": true,
    "html": true,
    "toml": true,
  },
  "theme": "Catppuccin Macchiato",
  "ui_font_family": "JetBrainsMono Nerd Font Propo",
  "ui_font_size": 14,
  "ui_font_weight": 400,
  "ui_font_features": {
    "zero": true,
  },
  "buffer_font_family": "JetBrainsMono Nerd Font Propo",
  "buffer_font_size": 15,
  "buffer_font_weight": 600,
  "buffer_font_features": {
    "zero": true,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "format_on_save": "off",
  "formatter": "prettier",
  "vim_mode": true,
  "cursor_blink": false,
  "relative_line_numbers": "enabled",
  // "active_pane_magnification": 1.5,
  "extend_comment_on_newline": false,
  "lsp": {
    "tinymist": {
      "initialization_options": {
        "preview": {
          "background": {
            "enabled": true,
          },
        },
      },
      "settings": {
        "exportPdf": "never",
        "outputPath": "$root/out/$name",
      },
    },
  },
}
